<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d1bda854-a743-4a33-9647-1c0b4759eeaa</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <DefaultItemExcludes>$(DefaultItemExcludes);Library.Core\**;Library.BLL\**;Library.DAL\**;Library.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Library.BLL\Library.BLL.csproj" />
    <ProjectReference Include="Library.Core\Library.Core.csproj" />
    <ProjectReference Include="Library.DAL\Library.DAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Library.Core\**" />
    <Compile Remove="Library.BLL\**" />
    <Compile Remove="Library.DAL\**" />
    <Compile Remove="Library.Tests\**" />
  </ItemGroup>

</Project>
